{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backroom",
  "version": "0.1.0",
  "identifier": "app.backroom.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["backroom"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Backroom",
    "category": "Productivity",
    "shortDescription": "Backroom team chat",
    "longDescription": "Desktop app for Backroom, a self-hosted team chat. Asks for your server's address on first launch.",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/backroom.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "linux/backroom.desktop.hbs"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "2c8bd498-713d-4f0c-ba49-3baaceebe45b"
      }
    },
    "macOS": {
      "hardenedRuntime": false
    }
  }
}

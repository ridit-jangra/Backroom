# Backroom Node server configuration. The server reads these from its environment (it does not load .env files
# itself: export them, or use `node --env-file=.env dist/server.mjs`, a systemd EnvironmentFile, etc.).
# Keep the real file private (chmod 600): it holds the Resend API key.

# REQUIRED. The public URL people open: http(s), no path. Sign-in links and the same-origin check use it.
APP_ORIGIN=https://chat.example.com

# REQUIRED. The workspace owner's email address (the first person allowed to sign in).
OWNER_EMAIL=you@example.com

# Resend API key for sign-in emails. Unset or "dev" selects the console mailer, which prints sign-in links to
# stdout instead (for local development; the server warns loudly when APP_ORIGIN is https and this is unset).
RESEND_API_KEY=
# Sender address for sign-in emails (must be a domain verified in Resend).
EMAIL_FROM=Backroom <noreply@localhost>

# Where the SQLite database (backroom.sqlite) and uploaded files (blobs/) live. Created with mode 700.
# Relative paths are resolved from the working directory. Back up this whole folder.
DATA_DIR=./data

# Listen address. The default 127.0.0.1 only accepts connections from the same machine (put a reverse proxy in
# front). In a container whose port is published or routed by the host, set HOST=0.0.0.0.
PORT=8080
HOST=127.0.0.1

# Which request header holds the real client IP (rate limits use it). Leave EMPTY unless the server is reachable
# ONLY through your proxies: anyone who can reach the port directly could otherwise forge the header and dodge
# the rate limits. Without it, the client IP is the TCP peer address (your proxy's address behind a proxy).
#   cf-connecting-ip  Cloudflare's proxy (orange cloud) in front, possibly followed by your own reverse proxy:
#                     the address Cloudflare saw. Only safe if your proxy accepts traffic from Cloudflare alone
#                     or overwrites the header itself.
#   x-forwarded-for   a single reverse proxy of your own: the LAST address in the list (the one your proxy
#                     appended). Behind several proxies use the header the outermost one sets instead.
#   x-real-ip (or any single-valued header your proxy sets)
# A configured header that is missing or malformed falls back to the TCP peer address.
TRUSTED_PROXY_HEADER=

# The built web app (npm run build -w apps/web). Default: apps/web/dist relative to the server bundle
# (apps/server/dist/server.mjs -> apps/web/dist). The --web-dist <path> flag wins over this.
# WEB_DIST=/srv/backroom/web

# Optional limits in bytes. Defaults: FILES_QUOTA_BYTES=943718400 (900 MB of files, thumbnails and custom emoji per
# workspace), FILE_MAX_BYTES=26214400 (25 MB per upload; also the largest request body the server accepts).
# The web client refuses files over 25 MB on its own, so raising FILE_MAX_BYTES above that needs a client change;
# lowering it works as is. Your reverse proxy's body size limit must be at least FILE_MAX_BYTES.
# FILES_QUOTA_BYTES=943718400
# FILE_MAX_BYTES=26214400

# Command-line flags:
#   --maintenance        run the daily maintenance (normally 04:00 server local time) once and exit
#   --web-dist <path>    the built web app (instead of WEB_DIST)

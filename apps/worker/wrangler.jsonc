{
  "name": "backroom",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Served only at the custom domain passed to `npm run deploy` (--domain). No workers.dev address
  // and no preview URLs, so the account does not need a workers.dev subdomain.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backroom",
      "database_id": "<set at deploy>",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "WorkspaceHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceHub"] }],
  // Blob storage (files, thumbnails, custom emoji) is Workers KV: free without a payment card. No R2 binding:
  // it makes `wrangler deploy` fail while R2 is not enabled on the account. Local dev uses a local KV.
  "kv_namespaces": [{ "binding": "BLOBS", "id": "<set at deploy>" }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/me", "/w/*", "/invites/*", "/health", "/channels/*", "/messages/*", "/emoji/*", "/files/*", "/ws"]
  },
  "triggers": { "crons": ["0 4 * * *"] },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "EMAIL_FROM": "Backroom <backroom@example.com>"
  }
}

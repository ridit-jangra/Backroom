{
  "name": "backroom",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backroom",
      "database_id": "<set at deploy>",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "WorkspaceHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceHub"] }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "backroom" }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/me", "/w/*", "/invites/*", "/health", "/channels/*", "/messages/*", "/emoji/*", "/ws"]
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "EMAIL_FROM": "Backroom <login@example.com>"
  }
}

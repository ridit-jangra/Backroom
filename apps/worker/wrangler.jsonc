{
  "name": "backroom",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backroom",
      "database_id": "<set at deploy>",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/me", "/w/*", "/invites/*", "/health"]
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "EMAIL_FROM": "Backroom <login@example.com>"
  }
}
